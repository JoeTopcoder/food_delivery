# Call Fallback (private telephone bridge) — provider configuration.
# Set these as Supabase Edge Function secrets (NOT in the Flutter build):
#   supabase secrets set TWILIO_ACCOUNT_SID=... TWILIO_AUTH_TOKEN=... TWILIO_CALLER_ID=... CALL_FALLBACK_PROVIDER=twilio
#
# Until these are set AND CALL_FALLBACK_PROVIDER=twilio, the code runs in MOCK mode
# (no real/paid calls). The app_config flag `call_fallback_enabled` must ALSO be
# true (admin) for any fallback to run. Placeholders only below.

# 'mock' (default) or 'twilio'
CALL_FALLBACK_PROVIDER=mock

# Twilio Programmable Voice credentials (backend-only; never shipped to clients)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Approved HotBite caller ID in E.164 (a Twilio number or verified/approved CNAM).
# Used on BOTH outbound legs so the driver's number is never forwarded to the
# customer. Do NOT claim a Jamaican local caller ID unless Twilio has provisioned
# and approved one for your account.
TWILIO_CALLER_ID=+1xxxxxxxxxx

# Supabase injects SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY
# automatically — do not set them here.
