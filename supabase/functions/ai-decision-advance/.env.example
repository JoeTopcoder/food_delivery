# AI Decision Room — provider keys (Supabase Edge Function secrets; NEVER in Flutter).
#   supabase secrets set OPENAI_API_KEY=sk-... ANTHROPIC_API_KEY=sk-ant-...
# If a key is absent, that provider's stages run in clearly-labelled MOCK mode
# (no paid calls). OPENAI_API_KEY is already set for other AI features.

OPENAI_API_KEY=sk-xxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Optional model overrides:
OPENAI_DECISION_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
