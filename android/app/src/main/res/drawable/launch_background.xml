<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Midnight Navy background -->
    <item android:drawable="@color/brand_bg" />

    <!-- QuickDash mark, centred at its intrinsic 210x130dp. Referenced
         directly rather than wrapped in <bitmap>, which only takes raster
         resources and silently fails on a vector. -->
    <item
        android:drawable="@drawable/quickdash_mark"
        android:gravity="center" />
</layer-list>
