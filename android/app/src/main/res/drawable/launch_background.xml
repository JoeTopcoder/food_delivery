<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Appetizing food backdrop on the first (native) launch window. -->
    <item>
        <bitmap
            android:src="@drawable/splash_food"
            android:gravity="fill" />
    </item>

    <!-- Dark scrim so the HotBite mark stays legible over the photo. -->
    <item>
        <color android:color="#99000000" />
    </item>

    <!-- HotBite mark, centred. -->
    <item
        android:drawable="@drawable/hotbite_mark"
        android:gravity="center" />
</layer-list>
